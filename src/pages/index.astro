---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PathNavigator from '../components/PathNavigator.astro';
import { itinerary } from '../data/itinerary';
import { siteConfig } from '../data/config';
---

<BaseLayout title="Forgotten Bali">
	<Header />
	<PathNavigator />
	<main id="main-content">
		<!-- Hero Section -->
		<section class="relative h-screen flex items-center justify-center overflow-hidden">
			<div class="absolute inset-0">
				<img src="/hero.png" alt="Misty Bali Ridge" class="w-full h-full object-cover scale-110 animate-subtle-zoom">
				<div class="hero-gradient absolute inset-0"></div>
			</div>

			<div class="relative z-10 text-center px-6 max-w-5xl mx-auto">
				<p class="text-rice-300 text-[10px] tracking-[0.5em] uppercase mb-8 font-semibold">Limited to 8 Guests &bull; April 4&#8211;13, 2026</p>
				<h1 class="font-serif text-5xl sm:text-7xl md:text-8xl text-white mb-8 leading-[0.9] tracking-tighter">
					Forgotten Bali.
				</h1>
				<p class="text-mist-200 text-lg sm:text-2xl mb-12 font-light max-w-2xl mx-auto leading-relaxed">
					A curated 10-day journey into the misty ridges, hidden waterfalls, ancient temples and sacred springs.
				</p>
				<div class="flex flex-col sm:flex-row gap-6 justify-center reveal">
					<a href="#itinerary" class="bg-white text-jungle-900 px-10 py-5 rounded-sm font-medium text-sm uppercase tracking-widest hover:bg-rice-300 transition-all">
						View the Path
					</a>
				</div>
			</div>

			<div class="absolute bottom-10 left-10 hidden lg:block">
				<div class="flex items-center gap-4 text-[10px] uppercase tracking-[0.3em] text-white/40">
					<span class="w-12 h-px bg-white/20"></span>
					Scroll to Begin
				</div>
			</div>
		</section>

		<!-- Trip Facts Band -->
		<section class="bg-jungle-950 border-y border-white/5">
			<div class="max-w-7xl mx-auto px-6 py-10">
				<div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
					<div class="reveal">
						<p class="text-white/40 text-[10px] uppercase tracking-[0.3em]">Dates</p>
						<p class="text-white text-lg font-serif">Apr 4&#8211;13, 2026</p>
					</div>
					<div class="reveal">
						<p class="text-white/40 text-[10px] uppercase tracking-[0.3em]">Group Size</p>
						<p class="text-white text-lg font-serif">Only 8 guests</p>
					</div>
					<div class="reveal">
						<p class="text-white/40 text-[10px] uppercase tracking-[0.3em]">Season</p>
						<p class="text-white text-lg font-serif">Ideal post-wet</p>
					</div>
					<div class="reveal">
						<p class="text-white/40 text-[10px] uppercase tracking-[0.3em]">Pace</p>
						<p class="text-white text-lg font-serif">Active + restorative</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Manifesto Section -->
		<section id="manifesto" class="py-32 bg-volcanic-900 overflow-hidden">
			<div class="max-w-4xl mx-auto px-6">
				<div class="text-center">
					<p class="text-rice-400 text-[10px] tracking-[0.4em] uppercase mb-6 font-bold reveal">The Insider&#8217;s Run</p>
					<h2 class="font-serif text-5xl md:text-7xl text-white mb-12 reveal tracking-tighter">I&#8217;m opening up <br class="md:hidden"> my black book.</h2>
					<div class="space-y-10 text-xl md:text-2xl font-light text-mist-200 leading-relaxed max-w-2xl mx-auto">
						<p class="reveal">For the last four years, I&#8217;ve been scouting the Deep North&#8212;taking my mum to the temples, my mates to the waterfalls, and my partners to the most romantic mountain cabins.</p>
						<p class="reveal font-serif italic text-white text-2xl md:text-3xl">&#8220;Now, I&#8217;m inviting a small group of only 8 people from home to come with me.&#8221;</p>
						<p class="reveal text-lg text-mist-400">We&#8217;ll stay in the same world-class sanctuaries I take my family to, but we&#8217;ll travel like locals. No rigid itineraries, no tourist traps&#8212;just a private circuit of the island&#8217;s most beautiful corners.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Mid-Page CTA -->
		<section class="py-16 bg-volcanic-950 border-y border-white/5">
			<div class="max-w-5xl mx-auto px-6 text-center">
				<p class="text-rice-400 text-[10px] tracking-[0.3em] uppercase mb-4 font-bold">Ready for the invite?</p>
				<h3 class="font-serif text-3xl md:text-4xl text-white mb-8">Let&#8217;s see if the expedition is a fit.</h3>
				<a href="#apply" class="inline-block bg-rice-400 text-jungle-900 px-10 py-5 rounded-sm font-bold text-xs uppercase tracking-[0.25em] hover:bg-white transition-all">
					Book a Quick Call
				</a>
			</div>
		</section>

		<!-- Meet Your Insider (Bio) -->
		<section id="the-insider" class="py-32 bg-jungle-900 border-y border-white/5">
			<div class="max-w-6xl mx-auto px-6">
				<div class="grid lg:grid-cols-2 gap-20 items-center">
					<div class="relative reveal">
						<div class="aspect-[4/5] overflow-hidden rounded-sm transition-all duration-1000 shadow-2xl">
							<div id="bio-frame" class="w-full h-full relative rotating-frame">
							<img src="/assets/bio/webp/IMG_0515.webp" alt="James Dawson exploring Bali" class="absolute inset-0 w-full h-full object-cover">
							<img src="/assets/bio/webp/IMG_0643.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0722.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0734.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0745.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0746.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0755.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0785.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0801.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0806.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0850.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0857.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							</div>
						</div>
						<div class="absolute -bottom-6 -right-6 bg-rice-400 text-jungle-900 p-8 hidden md:block">
							<p class="font-serif text-2xl italic">&#8220;I&#8217;ve mapped the routes they haven&#8217;t found.&#8221;</p>
						</div>
					</div>

					<div class="reveal">
						<p class="text-rice-400 text-[10px] tracking-[0.4em] uppercase mb-6 font-bold">Hosted by James Dawson</p>
						<h2 class="font-serif text-5xl md:text-7xl text-white mb-8">Sydney Local. <br> Bali Resident.</h2>
						<div class="space-y-6 text-mist-50 text-xl md:text-2xl leading-relaxed font-light">
							<p>I&#8217;ve worked as an outdoor guide for nearly a decade, but North Bali is the only place that ever made me stop moving. I&#8217;ve lived here since 2022, spending the last four years mapping the ridges, timing the tides, and figuring out exactly when to hit the popular spots so we have them entirely to ourselves.</p>
							<p>This isn&#8217;t just a route I&#8217;ve planned; it&#8217;s a collection of memories. It&#8217;s where I brought my dad for a Bintang on a volcano rim when he was sick. It&#8217;s the quiet temples I retreated to when I lost him. It&#8217;s the hidden valleys where I&#8217;ve taken my closest friends to show them what this island is actually capable of.</p>
							<p>I&#8217;m opening this pilot trip to my community back home because I want to show you the Bali that exists beyond the traffic. I don&#8217;t run tours; I run expeditions. I handle the logistics, the safety, and the timing&#8212;you just need to show up.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Who It's For -->
		<section id="fit" class="py-32 bg-jungle-900 border-y border-white/5">
			<div class="max-w-6xl mx-auto px-6">
				<div class="text-center mb-16">
					<p class="text-rice-400 text-[10px] tracking-[0.4em] uppercase mb-6 font-bold">Fit Check</p>
					<h2 class="font-serif text-5xl md:text-6xl text-white tracking-tighter">Who This Is For.</h2>
					<p class="text-mist-400 text-sm mt-4 max-w-lg mx-auto">We welcome travellers 30+ who value adventure, comfort, and meaningful connection. Our key demographic is fit, semi-retired explorers&#8212;but anyone with the right energy is welcome.</p>
				</div>
				<div class="grid md:grid-cols-2 gap-12">
					<div class="reveal p-8 bg-volcanic-900/60 border border-white/5 rounded-sm">
						<h3 class="font-serif text-2xl text-white mb-6">It&#8217;s for you if&#8230;</h3>
						<ul class="space-y-4 text-mist-200 text-sm">
							<li class="flex items-start gap-4">
								<span class="w-1.5 h-1.5 bg-rice-400 rounded-full mt-2"></span>
								You want hidden locations and fewer crowds without sacrificing comfort.
							</li>
							<li class="flex items-start gap-4">
								<span class="w-1.5 h-1.5 bg-rice-400 rounded-full mt-2"></span>
								You&#8217;re open to early starts, short hikes, and spontaneous moments.
							</li>
							<li class="flex items-start gap-4">
								<span class="w-1.5 h-1.5 bg-rice-400 rounded-full mt-2"></span>
								You value a curated, small-group vibe over a traditional tour.
							</li>
						</ul>
					</div>
					<div class="reveal p-8 bg-volcanic-900/60 border border-white/5 rounded-sm">
						<h3 class="font-serif text-2xl text-white mb-6">It&#8217;s not ideal if&#8230;</h3>
						<ul class="space-y-4 text-mist-200 text-sm">
							<li class="flex items-start gap-4">
								<span class="w-1.5 h-1.5 bg-rice-400 rounded-full mt-2"></span>
								You prefer rigid schedules or large, bus-style groups.
							</li>
							<li class="flex items-start gap-4">
								<span class="w-1.5 h-1.5 bg-rice-400 rounded-full mt-2"></span>
								You want nightlife-focused travel rather than nature immersion.
							</li>
							<li class="flex items-start gap-4">
								<span class="w-1.5 h-1.5 bg-rice-400 rounded-full mt-2"></span>
								You need fully guided, low-movement days every day.
							</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- Social Proof (Reviews) -->
		<section id="reviews" class="py-32 bg-jungle-800 border-b border-white/5 overflow-hidden">
			<div class="max-w-4xl mx-auto px-6">
				<div class="text-center mb-16 reveal">
					<p class="text-rice-400 text-[10px] tracking-[0.4em] uppercase mb-6 font-bold">800+ Five-Star Reviews</p>
					<h2 class="font-serif text-5xl md:text-6xl text-white tracking-tighter">What Guests Say.</h2>
					<p class="text-mist-400 text-sm mt-4 max-w-lg mx-auto">From years of guiding experiences across Sydney and Bali.</p>
				</div>
				<div id="reviews-slider" class="relative">
					<div class="reviews-track flex transition-transform duration-1000 ease-in-out">
						<!-- Slide 1 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								&#8220;Felt very safe and went at a pace that worked for the entire group. James is a great guy&#8212;you really get to see the area through the eyes of a local.&#8221;
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Annabelle &bull; Birmingham, UK</cite>
						</div>
						<!-- Slide 2 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								&#8220;The best part was the meaningfulness brought to the experience through the storytelling and facts. James is brilliant at tailoring the experience to each participant&#8217;s needs.&#8221;
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Tahli &bull; Melbourne, AU</cite>
						</div>
						<!-- Slide 3 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								&#8220;James was able to tell us so much about the environment. Definitely felt more personal, like going on a trip with a friend. Highly recommend!&#8221;
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Lindsay &bull; Uranquinty, AU</cite>
						</div>
						<!-- Slide 4 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								&#8220;James is great&#8212;very kind, with a lot of knowledge and passion for what he does. He knows his way around and showed us incredible spots.&#8221;
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Michaela &bull; Munich, DE</cite>
						</div>
						<!-- Slide 5 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								&#8220;James is an expert in his craft and he enjoys every moment of it. Safe, fun, and very educational.&#8221;
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Jesse &bull; Japan</cite>
						</div>
						<!-- Slide 6 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								&#8220;His friendly and calm demeanor put all of us at ease. James was able to support everyone and made it look easy!&#8221;
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Mykol &bull; Wisconsin, US</cite>
						</div>
						<!-- Slide 7 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								&#8220;James gave us all his attention and time. I really had a great time and felt like I was going out with a friend.&#8221;
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Isha &bull; Melbourne, AU</cite>
						</div>
						<!-- Slide 8 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								&#8220;Clear communication in what to expect. James was knowledgeable and inclusive throughout our adventure.&#8221;
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Christina &bull; Saskatoon, CA</cite>
						</div>
						<!-- Slide 9 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								&#8220;You could tell that he was an expert at what he did. His gentle and calm personality kept us feeling secure.&#8221;
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Shivshankar &bull; Singapore</cite>
						</div>
						<!-- Slide 10 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								&#8220;James was super knowledgeable and friendly, and I felt safe the entire time. 10/10.&#8221;
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Gracie &bull; Horsham, AU</cite>
						</div>
					</div>

					<!-- Navigation Buttons -->
					<div class="absolute top-1/2 -translate-y-1/2 -left-4 md:-left-12 lg:-left-20">
					<button id="prev-review" class="p-4 text-white/20 hover:text-rice-400 transition-colors" aria-label="Previous review">
						<svg class="w-8 h-8 md:w-12 md:h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 19l-7-7 7-7" />
						</svg>
					</button>
					</div>
					<div class="absolute top-1/2 -translate-y-1/2 -right-4 md:-right-12 lg:-right-20">
					<button id="next-review" class="p-4 text-white/20 hover:text-rice-400 transition-colors" aria-label="Next review">
						<svg class="w-8 h-8 md:w-12 md:h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 5l7 7-7 7" />
						</svg>
					</button>
					</div>
				</div>
			</div>
		</section>

		<!-- The Path (Itinerary) -->
		<section id="itinerary" class="py-32 bg-volcanic-900">
			<div class="max-w-7xl mx-auto px-6">
				<div class="mb-24 flex flex-col md:flex-row md:items-end justify-between gap-8">
					<div>
						<p class="text-rice-400 text-[10px] tracking-[0.4em] uppercase mb-6 font-bold">The Expedition Path</p>
						<h2 class="font-serif text-5xl md:text-8xl text-white leading-none tracking-tighter">Ten Days of <br> Discovery.</h2>
					</div>
					<div class="max-w-md text-mist-300">
						<p>We move with the sun. From the black sand of the west to the misty ridges of the north, every stop is intentional. No filler. No tourist traps.</p>
					</div>
				</div>

				<div class="mb-16 grid sm:grid-cols-4 gap-6 text-center reveal">
					<div class="p-6 bg-volcanic-950/60 border border-white/5 rounded-sm">
						<p class="text-white/40 text-[10px] uppercase tracking-[0.3em] mb-2">Days 1&#8211;2</p>
						<p class="text-white font-serif text-xl">Coast &amp; black sand</p>
					</div>
					<div class="p-6 bg-volcanic-950/60 border border-white/5 rounded-sm">
						<p class="text-white/40 text-[10px] uppercase tracking-[0.3em] mb-2">Days 3&#8211;6</p>
						<p class="text-white font-serif text-xl">Misty ridges</p>
					</div>
					<div class="p-6 bg-volcanic-950/60 border border-white/5 rounded-sm">
						<p class="text-white/40 text-[10px] uppercase tracking-[0.3em] mb-2">Days 7&#8211;8</p>
						<p class="text-white font-serif text-xl">Temples &amp; falls</p>
					</div>
					<div class="p-6 bg-volcanic-950/60 border border-white/5 rounded-sm">
						<p class="text-white/40 text-[10px] uppercase tracking-[0.3em] mb-2">Days 9&#8211;10</p>
						<p class="text-white font-serif text-xl">Soft landing by sea</p>
					</div>
				</div>

				<div class="grid lg:grid-cols-2 gap-12 lg:gap-24 items-center">
					<div class="reveal">
						<div class="relative group aspect-[16/9] overflow-hidden rounded-sm shadow-2xl bg-volcanic-800">
							<img src="/assets/WakaGangga/beach.jpg" alt="Expedition Start" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105">
							<div class="absolute inset-0 bg-jungle-950/40 group-hover:bg-jungle-950/20 transition-colors"></div>
							<div class="absolute inset-0 flex items-center justify-center">
								<a href="/itinerary/1" class="bg-white text-jungle-900 px-10 py-5 rounded-sm font-bold uppercase tracking-widest hover:bg-rice-400 transition-all transform hover:scale-105 shadow-2xl">
									Begin the Journey
								</a>
							</div>
						</div>
					</div>
					
					<div class="reveal space-y-8">
						<h3 class="font-serif text-4xl text-white">The Path is Mapped.</h3>
						<p class="text-mist-200 text-xl font-light leading-relaxed">Each day has been curated to balance high-adrenaline discovery with profound sanctuary. We&#8217;ve mapped out the details into a granular, day-by-day guide.</p>
						
						<div class="grid grid-cols-2 sm:grid-cols-5 gap-3 pt-4">
							{itinerary.map(day => (
