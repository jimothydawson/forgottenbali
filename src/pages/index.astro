---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PathNavigator from '../components/PathNavigator.astro';
import { itinerary } from '../data/itinerary';
---

<BaseLayout title="Forgotten Bali | The Pilot Expedition">
	<Header />
	<PathNavigator />
	<main id="main-content">
		<!-- Hero Section -->
		<section class="relative h-screen flex items-center justify-center overflow-hidden">
			<div class="absolute inset-0">
				<img src="/hero.png" alt="Misty Bali Ridge" class="w-full h-full object-cover scale-110 animate-subtle-zoom">
				<div class="hero-gradient absolute inset-0"></div>
			</div>

			<div class="relative z-10 text-center px-6 max-w-5xl mx-auto">
				<p class="text-rice-300 text-[10px] tracking-[0.5em] uppercase mb-8 font-semibold">Limited to 8 Guests • April 4–13, 2026</p>
				<h1 class="font-serif text-5xl sm:text-7xl md:text-8xl text-white mb-8 leading-[0.9] tracking-tighter">
					Forgotten Bali: <br class="hidden md:block"> The Pilot Expedition.
				</h1>
				<p class="text-mist-200 text-lg sm:text-2xl mb-12 font-light max-w-2xl mx-auto leading-relaxed">
					Not a tour. A road trip with friends. A curated 10-day journey into the misty ridges, hidden waterfalls, ancient temples and sacred springs.
				</p>
				<div class="flex flex-col sm:flex-row gap-6 justify-center reveal">
					<a href="#itinerary" class="bg-white text-jungle-900 px-10 py-5 rounded-sm font-medium text-sm uppercase tracking-widest hover:bg-rice-300 transition-all">
						View the Path
					</a>
					<a href="#apply" class="border border-white/30 text-white px-10 py-5 rounded-sm font-medium text-sm uppercase tracking-widest hover:bg-white hover:text-jungle-900 transition-all">
						Message James
					</a>
				</div>
			</div>

			<div class="absolute bottom-10 left-10 hidden lg:block">
				<div class="flex items-center gap-4 text-[10px] uppercase tracking-[0.3em] text-white/40">
					<span class="w-12 h-px bg-white/20"></span>
					Scroll to Begin
				</div>
			</div>
		</section>

		<!-- Trip Facts Band -->
		<section class="bg-jungle-950 border-y border-white/5">
			<div class="max-w-7xl mx-auto px-6 py-10">
				<div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
					<div class="reveal">
						<p class="text-white/40 text-[10px] uppercase tracking-[0.3em]">Dates</p>
						<p class="text-white text-lg font-serif">Apr 4–13, 2026</p>
					</div>
					<div class="reveal">
						<p class="text-white/40 text-[10px] uppercase tracking-[0.3em]">Group Size</p>
						<p class="text-white text-lg font-serif">Only 8 guests</p>
					</div>
					<div class="reveal">
						<p class="text-white/40 text-[10px] uppercase tracking-[0.3em]">Style</p>
						<p class="text-white text-lg font-serif">Curated road trip</p>
					</div>
					<div class="reveal">
						<p class="text-white/40 text-[10px] uppercase tracking-[0.3em]">Pace</p>
						<p class="text-white text-lg font-serif">Active + restorative</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Manifesto Section -->
		<section id="manifesto" class="py-32 bg-volcanic-900 overflow-hidden">
			<div class="max-w-4xl mx-auto px-6">
				<div class="text-center">
					<p class="text-rice-400 text-[10px] tracking-[0.4em] uppercase mb-6 font-bold reveal">The Insider's Run</p>
					<h2 class="font-serif text-5xl md:text-7xl text-white mb-12 reveal tracking-tighter">I'm opening up <br class="md:hidden"> my black book.</h2>
					<div class="space-y-10 text-xl md:text-2xl font-light text-mist-200 leading-relaxed max-w-2xl mx-auto">
						<p class="reveal">For the last four years, I’ve been scouting the Deep North—taking my mum to the temples, my mates to the waterfalls, and my partners to the most romantic mountain cabins.</p>
						<p class="reveal font-serif italic text-white text-2xl md:text-3xl">"Now, I’m inviting a small group of only 8 people from home to come with me."</p>
						<p class="reveal text-lg text-mist-400">We’ll stay in the same world-class sanctuaries I take my family to, but we’ll travel like locals. No rigid flags, no tourist traps—just a private circuit of the island’s most beautiful corners.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Mid-Page CTA -->
		<section class="py-16 bg-volcanic-950 border-y border-white/5">
			<div class="max-w-5xl mx-auto px-6 text-center">
				<p class="text-rice-400 text-[10px] tracking-[0.3em] uppercase mb-4 font-bold">Ready for the invite?</p>
				<h3 class="font-serif text-3xl md:text-4xl text-white mb-8">Let’s see if the expedition is a fit.</h3>
				<a href="#apply" class="inline-block bg-rice-400 text-jungle-900 px-10 py-5 rounded-sm font-bold text-xs uppercase tracking-[0.25em] hover:bg-white transition-all">
					Apply for a Spot
				</a>
			</div>
		</section>

		<!-- Meet Your Insider (Bio) -->
		<section id="the-insider" class="py-32 bg-jungle-900 border-y border-white/5">
			<div class="max-w-6xl mx-auto px-6">
				<div class="grid lg:grid-cols-2 gap-20 items-center">
					<div class="relative reveal">
						<div class="aspect-[4/5] overflow-hidden rounded-sm transition-all duration-1000 shadow-2xl">
							<div id="bio-frame" class="w-full h-full relative rotating-frame">
							<img src="/assets/bio/webp/IMG_0515.webp" alt="James Dawson exploring Bali" class="absolute inset-0 w-full h-full object-cover">
							<img src="/assets/bio/webp/IMG_0643.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0722.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0734.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0745.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0746.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0755.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0785.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0801.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0806.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0850.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							<img src="/assets/bio/webp/IMG_0857.webp" alt="" role="presentation" class="absolute inset-0 w-full h-full object-cover opacity-0">
							</div>
						</div>
						<div class="absolute -bottom-6 -right-6 bg-rice-400 text-jungle-900 p-8 hidden md:block">
							<p class="font-serif text-2xl italic">"I've mapped the routes they haven't found."</p>
						</div>
					</div>

					<div class="reveal">
						<p class="text-rice-400 text-[10px] tracking-[0.4em] uppercase mb-6 font-bold">Hosted by James Dawson</p>
						<h2 class="font-serif text-5xl md:text-7xl text-white mb-8">Manly Local. <br> Bali Resident.</h2>
						<div class="space-y-6 text-mist-50 text-xl md:text-2xl leading-relaxed font-light">
							<p>I’ve worked as an outdoor guide for nearly a decade, but North Bali is the only place that ever made me stop moving. I’ve lived here since 2022, spending the last four years mapping the ridges, timing the tides, and figuring out exactly when to hit the popular spots so we have them entirely to ourselves.</p>
							<p>This isn't just a route I’ve planned; it’s a collection of memories. It’s where I brought my dad for a Bintang on a volcano rim when he was sick. It’s the quiet temples I retreated to when I lost him. It’s the hidden valleys where I’ve taken my closest friends to show them what this island is actually capable of.</p>
							<p>I’m opening this pilot trip to my community in Manly because I want to show you the Bali that exists beyond the traffic. I don't run tours; I run expeditions. I handle the logistics, the safety, and the timing—you just need to show up.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Who It's For -->
		<section id="fit" class="py-32 bg-jungle-900 border-y border-white/5">
			<div class="max-w-6xl mx-auto px-6">
				<div class="text-center mb-16">
					<p class="text-rice-400 text-[10px] tracking-[0.4em] uppercase mb-6 font-bold">Fit Check</p>
					<h2 class="font-serif text-5xl md:text-6xl text-white tracking-tighter">Who This Is For.</h2>
				</div>
				<div class="grid md:grid-cols-2 gap-12">
					<div class="reveal p-8 bg-volcanic-900/60 border border-white/5 rounded-sm">
						<h3 class="font-serif text-2xl text-white mb-6">It’s for you if…</h3>
						<ul class="space-y-4 text-mist-200 text-sm">
							<li class="flex items-start gap-4">
								<span class="w-1.5 h-1.5 bg-rice-400 rounded-full mt-2"></span>
								You want hidden locations and fewer crowds without sacrificing comfort.
							</li>
							<li class="flex items-start gap-4">
								<span class="w-1.5 h-1.5 bg-rice-400 rounded-full mt-2"></span>
								You’re open to early starts, short hikes, and spontaneous moments.
							</li>
							<li class="flex items-start gap-4">
								<span class="w-1.5 h-1.5 bg-rice-400 rounded-full mt-2"></span>
								You value a curated, small-group vibe over a traditional tour.
							</li>
						</ul>
					</div>
					<div class="reveal p-8 bg-volcanic-900/60 border border-white/5 rounded-sm">
						<h3 class="font-serif text-2xl text-white mb-6">It’s not ideal if…</h3>
						<ul class="space-y-4 text-mist-200 text-sm">
							<li class="flex items-start gap-4">
								<span class="w-1.5 h-1.5 bg-rice-400 rounded-full mt-2"></span>
								You prefer rigid schedules or large, bus-style groups.
							</li>
							<li class="flex items-start gap-4">
								<span class="w-1.5 h-1.5 bg-rice-400 rounded-full mt-2"></span>
								You want nightlife-focused travel rather than nature immersion.
							</li>
							<li class="flex items-start gap-4">
								<span class="w-1.5 h-1.5 bg-rice-400 rounded-full mt-2"></span>
								You need fully guided, low-movement days every day.
							</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- Social Proof (Reviews) -->
		<section id="reviews" class="py-32 bg-jungle-800 border-b border-white/5 overflow-hidden">
			<div class="max-w-4xl mx-auto px-6">
				<div id="reviews-slider" class="relative">
					<div class="reviews-track flex transition-transform duration-1000 ease-in-out">
						<!-- Slide 1 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">★★★★★</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								"James was super knowledgeable and friendly, and I felt safe the entire time. 10/10."
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Gracie • January 2026</cite>
						</div>
						<!-- Slide 2 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">★★★★★</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								"James is a great guy, you really get to see the area through the eyes of a local."
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Annabelle • March 2024</cite>
						</div>
						<!-- Slide 3 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">★★★★★</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								"James was an incredible kind and knowledgeable guide. I’m grateful for his suggestions."
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Divya • March 2024</cite>
						</div>
						<!-- Slide 4 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">★★★★★</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								"James is great, he is very kind, has a lot of knowledge and passion for what he does."
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Michaela • March 2024</cite>
						</div>
						<!-- Slide 5 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">★★★★★</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								"James is an expert in his craft and he enjoys every moment of it! Safe, fun, and educational."
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Jesse • February 2024</cite>
						</div>
						<!-- Slide 6 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">★★★★★</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								"James was amazing. He is passionate about the ocean and the beautiful life underwater."
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Léo • January 2024</cite>
						</div>
						<!-- Slide 7 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">★★★★★</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								"James was knowledgeable and inclusive. His knowledge of the area was super helpful for us!"
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Christina • December 2023</cite>
						</div>
						<!-- Slide 8 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">★★★★★</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								"The personalized attention and safety measures ensured a worry-free and enjoyable outing."
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Joerg • December 2023</cite>
						</div>
						<!-- Slide 9 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">★★★★★</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								"James's knowledge and love of the ocean shone through. His calm demeanor put all of us at ease."
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Mykol • March 2023</cite>
						</div>
						<!-- Slide 10 -->
						<div class="min-w-full flex flex-col items-center text-center px-4 md:px-10">
							<div class="text-rice-400 mb-8 flex gap-1 tracking-widest text-xs">★★★★★</div>
							<blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-white mb-10 leading-tight italic">
								"James is brilliant at tailoring the experience to each participant’s needs. Truly personal."
							</blockquote>
							<cite class="not-italic text-[10px] uppercase tracking-[0.4em] text-white/40 font-bold">Tahli • January 2023</cite>
						</div>
					</div>

					<!-- Navigation Buttons -->
					<div class="absolute top-1/2 -translate-y-1/2 -left-4 md:-left-12 lg:-left-20">
					<button id="prev-review" class="p-4 text-white/20 hover:text-rice-400 transition-colors" aria-label="Previous review">
						<svg class="w-8 h-8 md:w-12 md:h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 19l-7-7 7-7" />
						</svg>
					</button>
					</div>
					<div class="absolute top-1/2 -translate-y-1/2 -right-4 md:-right-12 lg:-right-20">
					<button id="next-review" class="p-4 text-white/20 hover:text-rice-400 transition-colors" aria-label="Next review">
						<svg class="w-8 h-8 md:w-12 md:h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 5l7 7-7 7" />
						</svg>
					</button>
					</div>
				</div>
			</div>
		</section>
		<!-- Stays Section (Sanctuaries) -->
		<section id="sanctuaries" class="py-32 bg-volcanic-800">
			<div class="max-w-7xl mx-auto px-6">
				<div class="text-center mb-24 reveal">
					<p class="text-rice-400 text-[10px] tracking-[0.4em] uppercase mb-6 font-bold">The Sanctuaries</p>
					<h2 class="font-serif text-5xl md:text-7xl text-white mb-8 tracking-tighter">Where You'll Rest.</h2>
					<p class="text-mist-300 text-lg max-w-2xl mx-auto leading-relaxed">We aren't roughing it. Even though we’re going wild, we’re sleeping in style. These are the properties I personally vetted and fell in love with.</p>
				</div>

				<div class="space-y-48">
					<!-- WakaGangga -->
					<div class="grid lg:grid-cols-12 gap-12 lg:gap-24 items-center reveal">
						<div class="lg:col-span-12 mb-8">
							<div class="flex items-center gap-2 mb-4">
								<h3 class="font-serif text-4xl text-white">WakaGangga</h3>
								<div class="flex text-rice-400 gap-1 ml-4">
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
								</div>
							</div>
							<p class="text-mist-200 text-xl font-light max-w-3xl">Traditional luxury meets the wild black sand coast. Hand-carved villas tucked between the Indian Ocean and the rice paddies of Tabanan.</p>
						</div>
						<div class="lg:col-span-12">
							<div class="grid md:grid-cols-2 gap-8">
								<div class="aspect-[16/9] overflow-hidden rounded-none md:rounded-sm bg-volcanic-900 group -mx-6 md:mx-0">
									<img src="/assets/WakaGangga/aerial-beach.jpg" alt="Waka Aerial" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110">
								</div>
