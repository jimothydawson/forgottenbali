---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { hotels } from '../../data/hotels';

export function getStaticPaths() {
  return hotels.map((hotel) => ({
    params: { slug: hotel.slug },
    props: hotel,
  }));
}

const { title, description, days, location, badge, heroImage, subtitle, dailyDetails, whyTitle, whyText, whyImage, gallery, included, amenities, nextHotel } = Astro.props;
---

<BaseLayout title={`${title} | Forgotten Bali`} description={description}>
	<Header />

	<main id="main-content" class="bg-volcanic-950 text-mist-100 pt-20">
		<!-- Hero Section -->
		<section class="relative h-[70vh] min-h-[500px] flex items-end overflow-hidden">
			<div class="absolute inset-0">
				<img src={heroImage} alt={`${title} hero view`} class="w-full h-full object-cover">
				<div class="hero-gradient absolute inset-0 bg-gradient-to-t from-jungle-900/80 via-transparent to-jungle-900/60"></div>
			</div>

			<div class="relative z-10 w-full px-6 pb-12 sm:pb-16">
				<div class="max-w-4xl mx-auto">
					<a href="/#sanctuaries" class="inline-flex items-center gap-2 text-rice-300 text-sm mb-4 hover:text-white transition-colors uppercase tracking-widest font-semibold">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
						</svg>
						Back to Sanctuaries
					</a>
					<div class="flex items-center gap-3 mb-3">
						<p class="text-rice-400 text-sm tracking-[0.2em] uppercase font-bold">{days} • {location}</p>
						{badge && <span class="bg-rice-400 text-jungle-900 px-3 py-1 rounded-full text-[10px] uppercase font-bold tracking-wider">{badge}</span>}
					</div>
					<h1 class="font-serif text-5xl sm:text-6xl md:text-7xl text-white mb-6 tracking-tighter">{title}</h1>
					<p class="text-mist-200 text-lg sm:text-xl max-w-2xl font-light leading-relaxed mb-12">{subtitle}</p>
					
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						{dailyDetails.map(detail => (
							<div class="bg-white/5 border border-white/10 rounded-sm p-6 hover:border-rice-400/30 transition-all">
								<p class="text-rice-400 text-[10px] uppercase tracking-widest font-bold mb-2">{detail.label}</p>
								<p class="text-mist-100 text-sm font-light leading-relaxed">{detail.activity}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<!-- Why We Chose This -->
		<section class="py-24 sm:py-32 bg-volcanic-900">
			<div class="max-w-4xl mx-auto px-6">
				<div class="grid md:grid-cols-2 gap-16 items-center">
					<div class="reveal">
						<p class="text-rice-400 text-[10px] tracking-[0.4em] uppercase mb-4 font-bold">The Curation</p>
						<h2 class="font-serif text-3xl sm:text-4xl text-white mb-8 leading-tight">{whyTitle}</h2>
						<div class="space-y-6">
							{whyText.map(paragraph => (
								<p class="text-mist-200 leading-relaxed font-light">{paragraph}</p>
							))}
						</div>
					</div>
					<div class="aspect-[4/5] rounded-sm overflow-hidden shadow-2xl reveal">
						<img src={whyImage} alt={`${title} curation view`} class="w-full h-full object-cover">
					</div>
				</div>
			</div>
		</section>

		<!-- Included Activities (Optional) -->
		{included && (
			<section class="py-24 sm:py-32 bg-jungle-900">
				<div class="max-w-4xl mx-auto px-6">
					<p class="text-rice-400 text-[10px] tracking-[0.4em] uppercase mb-4 text-center font-bold">Expedition Focus</p>
					<h2 class="font-serif text-3xl sm:text-4xl text-white mb-16 text-center">Included Experiences</h2>

					<div class="grid sm:grid-cols-2 gap-8">
						{included.map(item => (
							<div class="bg-white/5 border border-white/10 rounded-sm p-8 hover:border-rice-400/30 transition-colors reveal">
								<h3 class="font-serif text-xl text-rice-300 mb-4">{item.title}</h3>
								<p class="text-mist-200 text-sm leading-relaxed font-light">{item.detail}</p>
							</div>
						))}
					</div>
				</div>
			</section>
		)}

		<!-- Gallery -->
		<section class="py-24 sm:py-32 bg-volcanic-800 overflow-hidden border-y border-white/5">
			<div class="max-w-6xl mx-auto px-6">
				<div class="text-center mb-16 reveal">
					<p class="text-rice-400 text-[10px] tracking-[0.4em] uppercase mb-4 font-bold">Aesthetics</p>
					<h2 class="font-serif text-4xl md:text-6xl text-white tracking-tighter">Visual Journal.</h2>
				</div>

				<div class="space-y-12 md:space-y-24">
					{gallery.map((item, index) => (
						<div class="reveal">
							<div class="aspect-[16/9] md:aspect-[21/9] overflow-hidden rounded-none md:rounded-sm shadow-2xl bg-volcanic-900 -mx-6 md:mx-0 group">
								<img 
									src={item.url} 
									alt={`${title} – ${item.caption}`} 
									class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
									loading="lazy"
								>
							</div>
							<div class="mt-6 md:mt-8 px-0 md:px-0">
								<p class="text-rice-400 text-[10px] uppercase tracking-[0.4em] font-bold mb-2">View {index + 1}</p>
								<p class="font-serif text-2xl md:text-3xl text-white tracking-tight">{item.caption}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Amenities -->
		<section class="py-24 sm:py-32 bg-volcanic-900">
			<div class="max-w-4xl mx-auto px-6">
				<div class="text-center mb-16">
					<p class="text-rice-400 text-[10px] tracking-[0.4em] uppercase mb-4 font-bold">Standard</p>
					<h2 class="font-serif text-3xl sm:text-4xl text-white">The Comforts</h2>
				</div>

				<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-12">
					{amenities.map(item => (
						<div class="flex flex-col items-center text-center p-4 reveal">
							<div class="w-px h-12 bg-rice-400 mb-6"></div>
							<h3 class="font-serif text-lg text-white mb-2">{item.title}</h3>
							<p class="text-mist-400 text-sm font-light leading-relaxed">{item.detail}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Continue Exploring -->
		<section class="py-32 bg-jungle-900 relative overflow-hidden">
			<div class="max-w-3xl mx-auto px-6 text-center relative z-10">
				<h2 class="font-serif text-4xl sm:text-6xl text-white mb-12 tracking-tighter">The Path Continues.</h2>
				<p class="text-mist-200 mb-16 text-xl font-light">Join us as we move deeper into the wild heart of the island.</p>
				<div class="flex flex-col sm:flex-row gap-6 justify-center">
					<a href={nextHotel.slug === '/' ? '/' : `/hotels/${nextHotel.slug}`} class="bg-rice-400 text-jungle-900 px-10 py-5 rounded-sm font-bold text-sm uppercase tracking-[0.2em] hover:bg-white transition-all reveal">
						{nextHotel.slug === '/' ? 'Back to Home' : `Next Sanctuary: ${nextHotel.name}`}
					</a>
					<a href="/#sanctuaries" class="border border-white/20 text-white px-10 py-5 rounded-sm font-bold text-sm uppercase tracking-[0.2em] hover:bg-white hover:text-jungle-900 transition-all reveal">
						View All Stays
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>
