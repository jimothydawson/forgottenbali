---
const days = [
  { id: 1, img: "/assets/WakaGangga/beach.jpg" },
  { id: 2, img: "/assets/jatiluwih/landscape-1.avif" },
  { id: 3, img: "/assets/day3/yoga.jpg" },
  { id: 4, img: "/assets/day3/banyumala.jpg" },
  { id: 5, img: "/assets/sekumpul/portrait-1.avif" },
  { id: 6, img: "/assets/sanglung/ocean-view.jpg" },
  { id: 7, img: "/assets/kintamani/batur-caldera.jpg" },
  { id: 8, img: "/assets/temples/temple-water-blessing.avif" },
  { id: 9, img: "/assets/maya-sanur/pool.jpg" },
  { id: 10, img: "/assets/maya-sanur/pool-beach.jpg" }
];
---

<div id="path-navigator-unified" class="fixed bottom-0 left-0 w-full z-50 transition-all duration-700">
  <div class="bg-volcanic-900/90 backdrop-blur-2xl border-t border-white/10 shadow-[0_-10px_40px_rgba(0,0,0,0.5)]">
    <div class="max-w-screen-xl mx-auto px-4 py-3 sm:py-5">
      <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-12">
        <!-- Brand/Status -->
        <div class="flex flex-row sm:flex-col items-center sm:items-start gap-4 sm:gap-0 sm:min-w-[140px]">
          <p class="text-rice-400 text-[9px] tracking-[0.4em] uppercase font-bold mb-1">The Expedition</p>
          <div class="flex gap-4">
             <a href="#the-insider" data-nav="the-insider" class="text-[10px] font-bold uppercase tracking-widest text-mist-400 hover:text-rice-400 transition-all">Me</a>
             <a href="#sanctuaries" data-nav="sanctuaries" class="text-[10px] font-bold uppercase tracking-widest text-mist-400 hover:text-white transition-all">Stays</a>
          </div>
        </div>

        <!-- Itinerary Grid -->
        <div class="flex-grow w-full">
          <div class="grid grid-cols-5 md:grid-cols-10 gap-1.5 sm:gap-3">
            {days.map((day) => (
              <a 
                href={`#day-${day.id}`} 
                data-day={day.id}
                class="relative aspect-[4/3] group overflow-hidden rounded-xs sm:rounded-sm border border-white/5 transition-all duration-500 hover:scale-105 active:scale-95"
              >
                <img src={day.img} alt={`Day ${day.id}`} class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:opacity-100 transition-opacity duration-500" />
                <div class="absolute inset-0 bg-jungle-950/40 group-hover:bg-transparent transition-all duration-500"></div>
                <div class="relative z-10 flex items-center justify-center h-full">
                  <span class="text-[10px] sm:text-xs font-serif italic text-white group-hover:text-rice-400 group-hover:text-sm transition-all duration-300 drop-shadow-lg">{day.id}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #path-navigator-unified .active {
    border-color: var(--color-rice-400) !important;
    background-color: var(--color-rice-400) !important;
    transform: scale(1.1);
  }
  
  #path-navigator-unified .active img {
    opacity: 1 !important;
  }
  
  #path-navigator-unified .active span {
    color: var(--color-jungle-900) !important;
    font-weight: 800;
  }

  a[data-nav].active {
    color: var(--color-rice-400) !important;
    background: transparent !important;
  }
</style>
