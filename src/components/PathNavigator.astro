---
const days = [
  { id: 1, img: "/assets/WakaGangga/beach.jpg" },
  { id: 2, img: "/assets/jatiluwih/landscape-1.avif" },
  { id: 3, img: "/assets/day3/yoga.jpg" },
  { id: 4, img: "/assets/day3/banyumala.jpg" },
  { id: 5, img: "/assets/sekumpul/portrait-1.avif" },
  { id: 6, img: "/assets/sanglung/ocean-view.jpg" },
  { id: 7, img: "/assets/kintamani/batur-caldera.jpg" },
  { id: 8, img: "/assets/temples/temple-water-blessing.avif" },
  { id: 9, img: "/assets/maya-sanur/pool.jpg" },
  { id: 10, img: "/assets/maya-sanur/pool-beach.jpg" }
];
---

<div id="path-navigator-unified" class="fixed bottom-0 left-0 w-full z-50 transition-all duration-700">
  <div class="bg-volcanic-900/95 backdrop-blur-3xl border-t border-white/10 shadow-[0_-10px_50px_rgba(0,0,0,0.6)]">
    <div class="max-w-screen-2xl mx-auto px-4 py-2 sm:py-3">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 md:gap-8">
        <!-- Brand/Status -->
        <div class="flex items-center gap-6 shrink-0">
          <p class="hidden md:block text-rice-400 text-[10px] tracking-[0.5em] uppercase font-bold">The Path</p>
          <div class="flex gap-6">
             <a href="#the-insider" data-nav="the-insider" class="text-[11px] font-bold uppercase tracking-widest text-mist-300 hover:text-white transition-all">Me</a>
             <a href="#sanctuaries" data-nav="sanctuaries" class="text-[11px] font-bold uppercase tracking-widest text-mist-300 hover:text-white transition-all">Stays</a>
          </div>
        </div>

        <!-- Itinerary Grid -->
        <div class="w-full max-w-4xl">
          <div class="grid grid-cols-10 gap-1 sm:gap-2 md:gap-3">
            {days.map((day) => (
              <a 
                href={`#day-${day.id}`} 
                data-day={day.id}
                class="relative aspect-[4/3] group overflow-hidden rounded-xs border border-white/5 transition-all duration-500 hover:scale-110 active:scale-95 shadow-lg"
              >
                <img src={day.img} alt={`Day ${day.id}`} class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-100 transition-opacity duration-500" />
                <div class="absolute inset-0 bg-jungle-950/40 group-hover:bg-transparent transition-all duration-500"></div>
                <div class="relative z-10 flex items-center justify-center h-full">
                  <span class="text-xs sm:text-sm md:text-base font-serif italic text-white group-hover:text-rice-400 group-active:text-rice-400 transition-all duration-300 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">{day.id}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #path-navigator-unified .active {
    border-color: var(--color-rice-400) !important;
    background-color: var(--color-rice-400) !important;
    transform: scale(1.15);
    z-index: 20;
  }
  
  #path-navigator-unified .active img {
    opacity: 1 !important;
  }
  
  #path-navigator-unified .active span {
    color: var(--color-jungle-900) !important;
    font-weight: 900;
    text-shadow: none;
  }

  a[data-nav].active {
    color: var(--color-rice-400) !important;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
