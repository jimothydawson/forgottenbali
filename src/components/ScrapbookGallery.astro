---
interface ImageItem {
  src: string;
  alt: string;
  span?: 'full' | 'half' | 'third' | 'portrait';
}

interface Props {
  images: ImageItem[];
}

const { images } = Astro.props;

// Helper to map span to Tailwind classes
const getSpanClass = (span?: string) => {
  switch (span) {
    case 'full': return 'col-span-2 md:col-span-12 aspect-[16/9] md:aspect-[21/9]';
    case 'half': return 'col-span-2 md:col-span-6 aspect-square md:aspect-[16/9]';
    case 'third': return 'col-span-2 md:col-span-4 aspect-square';
    case 'portrait': return 'col-span-1 md:col-span-4 aspect-[2/3] md:aspect-[4/5]';
    default: return 'col-span-2 md:col-span-6 aspect-square md:aspect-[16/9]';
  }
};
---

<div class="grid grid-cols-2 md:grid-cols-12 gap-3 sm:gap-6 mt-12 reveal">
  {images.map((item) => (
    <div class={`${getSpanClass(item.span)} group overflow-hidden rounded-none md:rounded-sm bg-volcanic-900 shadow-xl`}>
      <img 
        src={item.src} 
        alt={item.alt} 
        class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  ))}
</div>
